# Purpose: documents every environment variable the server reads.
# Copy to .env (git-ignored) and adjust. Never put real secrets in this file.

# Port for local development. 4000 avoids macOS AirPlay, which squats on 5000 and 7000.
PORT=4000

# development | test | production
NODE_ENV=development

# The exact origin of the React app (scheme + host + port, no trailing slash).
CLIENT_ORIGIN=http://localhost:5173
